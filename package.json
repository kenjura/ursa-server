{
  "name": "@kenjura/ursa-server",
  "version": "0.1.0",
  "description": "Watch, rebuild, deploy, serve and edit Ursa sites",
  "author": "Andrew London <andrew@kenjura.com>",
  "license": "ISC",
  "type": "module",
  "bin": {
    "ursa-server": "bin/ursa-server.js"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/ursa-server.js start",
    "test": "node --test --test-concurrency=1 'test/**/*.test.js'",
    "link-ursa": "node scripts/link-ursa.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@kenjura/ursa": "^0.103.0",
    "express": "^4.21.0",
    "mime-types": "^2.1.35",
    "node-watch": "^0.7.4",
    "openid-client": "^6.8.0",
    "yaml": "^2.6.0",
    "yargs": "^17.7.2"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "ursa-server.example.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenjura/ursa-server.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
