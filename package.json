{
  "name": "@kenjura/ursa-server",
  "version": "0.3.0",
  "description": "Watch, rebuild, deploy, serve and edit Ursa sites",
  "author": "Andrew London <andrew@kenjura.com>",
  "license": "ISC",
  "type": "module",
  "bin": {
    "ursa-server": "bin/ursa-server.js"
  },
  "main": "src/index.js",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node bin/ursa-server.js start",
    "dev": "node bin/ursa-server.js dev",
    "test": "node scripts/build-ui.js && node --test --test-concurrency=1 'test/**/*.test.js'",
    "link-ursa": "node scripts/link-ursa.js",
    "build:ui": "node scripts/build-ui.js",
    "prepack": "node scripts/build-ui.js"
  },
  "dependencies": {
    "@aws-sdk/client-cloudfront": "^3.700.0",
    "@aws-sdk/client-s3": "^3.700.0",
    "@kenjura/ursa": "^0.104.0",
    "express": "^4.21.0",
    "mime-types": "^2.1.35",
    "node-watch": "^0.7.4",
    "openid-client": "^6.8.0",
    "yaml": "^2.6.0",
    "yargs": "^17.7.2"
  },
  "files": [
    "bin/",
    "src/",
    "docs/",
    "README.md",
    "CHANGELOG.md",
    "ursa-server.example.yml"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenjura/ursa-server.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.12.4",
    "@codemirror/merge": "^6.12.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.13",
    "@diplodoc/cut-extension": "^1.1.7",
    "@diplodoc/file-extension": "^0.2.6",
    "@diplodoc/tabs-extension": "^3.10.7",
    "@diplodoc/transform": "^4.78.7",
    "@gravity-ui/components": "^4.24.1",
    "@gravity-ui/markdown-editor": "^15.48.2",
    "@gravity-ui/uikit": "^7.51.0",
    "codemirror": "^6.0.2",
    "esbuild": "^0.28.2",
    "htm": "^3.1.1",
    "markdown-it": "^13.0.2",
    "preact": "^11.0.0",
    "process": "^0.11.10",
    "punycode": "^2.3.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
